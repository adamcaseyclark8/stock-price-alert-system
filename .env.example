# Alpaca API credentials (paper or live)
ALPACA_KEY_ID=your_alpaca_key_id
ALPACA_SECRET_KEY=your_alpaca_secret_key

# Optional: override Alpaca WebSocket URL
# ALPACA_WS_URL=wss://stream.data.alpaca.markets/v2/iex

# Kafka
KAFKA_BROKERS=localhost:9092

# Symbols to watch (comma-separated)
WATCH_SYMBOLS=AAPL,TSLA,MSFT

# Alert engine consumer group
KAFKA_GROUP_ID=alert-engine

# Path to rules JSON file (default: ./rules.json in cwd)
# RULES_FILE=./rules.json

# Optional webhook URL for alert delivery
# WEBHOOK_URL=https://hooks.example.com/alert
