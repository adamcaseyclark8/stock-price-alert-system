{
  "name": "stock-price-alert-system",
  "version": "1.0.0",
  "description": "Real-time stock price alerts via Alpaca WebSocket and Kafka",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev:consumer": "ts-node src/ws-consumer.ts",
    "dev:engine": "ts-node src/alert-engine.ts",
    "dev:notifier": "ts-node src/notifier.ts",
    "start:consumer": "node dist/ws-consumer.js",
    "start:engine": "node dist/alert-engine.js",
    "start:notifier": "node dist/notifier.js",
    "rules": "ts-node src/rules-cli.ts",
    "lint": "eslint src/**/*.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "kafkajs": "^2.2.4",
    "uuid": "^9.0.1",
    "ws": "^8.17.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.ts", "**/*.test.ts"]
  }
}
